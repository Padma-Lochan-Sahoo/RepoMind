# ------------------------------------------------------------
# RepoMind backend – environment template
# Copy to `.env` (same folder) and fill in real values:
#     cp .env.example .env
# `.env` is git-ignored. NEVER commit real secrets.
# ------------------------------------------------------------

# PostgreSQL (must have the pgvector extension available)
DATABASE_URL=jdbc:postgresql://localhost:5432/repomind
DATABASE_USERNAME=repomind
DATABASE_PASSWORD=change-me

# OpenAI – used for embeddings (text-embedding-3-small) and chat (gpt-4o-mini)
OPENAI_API_KEY=sk-your-openai-key

# GitHub OAuth App  (https://github.com/settings/developers)
#   Homepage URL:      http://localhost:3000
#   Authorization callback URL: http://localhost:8080/login/oauth2/code/github
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# URLs
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGIN=http://localhost:3000

# Encrypts GitHub access tokens at rest.
# Use a long random password and a HEX salt (e.g. `openssl rand -hex 16`).
TOKEN_ENCRYPTOR_PASSWORD=replace-with-a-long-random-string
TOKEN_ENCRYPTOR_SALT=replace-with-hex-string

# Optional
# PORT=8080
# SHOW_SQL=false
